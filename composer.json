{
    "name": "corvet/light-field-bundle",
    "description": "Custom fields with masked for Symfony 8",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergiy Bugayov",
            "email": "serg.bugayov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^8.0 || ^7.4 || ^6.4",
        "symfony/form": "^8.0 || ^7.4 || ^6.4",
        "symfony/twig-bundle": "^8.0 || ^7.4 || ^6.4",
        "symfony/stimulus-bundle": "^3.0 || ^2.0",
        "symfony/console": "^8.0 || ^7.4 || ^6.4"
    },
    "autoload": {
        "psr-4": {
            "Corvet\\LightFieldBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corvet\\LightFieldBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "Corvet\\LightFieldBundle\\CorvetLightFieldBundle"
        }
    }
}