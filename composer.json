{
    "name": "corvet/light-field-bundle",
    "description": "Custom date fields with masked for Symfony 8",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergiy Bugayov",
            "email": "serg.bugayov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "8.0.*",
        "symfony/form": "8.0.*",
        "symfony/twig-bundle": "8.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Corvet\\LightFieldBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corvet\\LightFieldBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "ux": {
                "masked-date": {
                    "controllers": {
                        "main": {
                            "enabled": true,
                            "fetch": "eager"
                        }
                    }
                }
            }
        }
    }
}